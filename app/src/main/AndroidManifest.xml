<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".MediStoreApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_app_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_app_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.MediStore">

        <!-- Login Screen (Launcher) -->
        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main Dashboard Activity -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />

        <!-- Medicine Management Activities -->
        <activity
            android:name=".ui.medicine.AddEditMedicineActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.medicine.MedicineDetailActivity"
            android:exported="false" />

        <!-- Sales / Billing Activities -->
        <activity
            android:name=".ui.sales.AddSaleActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.sales.SaleDetailActivity"
            android:exported="false" />

        <!-- Purchase Management Activities -->
        <activity
            android:name=".ui.purchase.AddPurchaseActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Supplier Management Activities -->
        <activity
            android:name=".ui.supplier.AddEditSupplierActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Customer Management Activities -->
        <activity
            android:name=".ui.customer.AddEditCustomerActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>

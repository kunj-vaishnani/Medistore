<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_dashboard">

    <fragment
        android:id="@+id/nav_dashboard"
        android:name="com.medistore.app.ui.dashboard.DashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_dashboard" />

    <fragment
        android:id="@+id/nav_medicines"
        android:name="com.medistore.app.ui.medicine.MedicineFragment"
        android:label="Medicines"
        tools:layout="@layout/fragment_medicine" />

    <fragment
        android:id="@+id/nav_sales"
        android:name="com.medistore.app.ui.sales.SalesHistoryFragment"
        android:label="Sales History"
        tools:layout="@layout/fragment_sales_history" />

    <fragment
        android:id="@+id/nav_inventory"
        android:name="com.medistore.app.ui.inventory.InventoryFragment"
        android:label="Inventory"
        tools:layout="@layout/fragment_inventory" />

    <fragment
        android:id="@+id/nav_more"
        android:name="com.medistore.app.ui.more.MoreFragment"
